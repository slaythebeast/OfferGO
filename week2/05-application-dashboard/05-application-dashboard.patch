+import React,{useState,useEffect} from 'react';
+import {programs} from '../library/data.js';
+import './dashboard.css';
+// Fictional applicant progress; scoped to the current page session.
+const seed={0:{status:'preparing',deadline:'2026-10-26',tasks:[2,2,2,2,2,1,0,0,0]},1:{status:'referee',deadline:'2026-11-18',tasks:[2,2,2,1,1,0,0,0,0]},2:{status:'preparing',deadline:'2026-12-10',tasks:[2,1,1,0,0,0,0,0,0]}};
+const stages=[{title:'阶段1：基础材料',tasks:[['official-transcript','整理官方成绩单及翻译件'],['weighted-mark','确认加权均分证明'],['final-modules','准备末年课程清单或学位证']]},{title:'阶段2：文书与推荐信',tasks:[['personal-statement','准备个人陈述（如项目要求）'],['academic-reference','确认学术推荐信 / 推荐人'],['language-proof','补充语言成绩或计划']]},{title:'阶段3：网申与递交',tasks:[['application-form','填写网申并复查字段'],['supporting-documents','上传该项目要求的材料'],['submit','最终核对并递交申请']]}];
+const cols=['preparing','referee','submitted','offer'];const meta={preparing:{label:'准备中',color:'blue'},referee:{label:'等待推荐人',color:'amber'},submitted:{label:'网申已递交',color:'violet'},offer:{label:'收到 Offer',color:'green'}};
+const progressOf=tasks=>Math.round((tasks.filter(x=>x===2).length+tasks.filter(x=>x===1).length*.5)/tasks.length*100);
+const seedState=()=>Object.fromEntries(programs.map(p=>{const base=seed[p.id]||{status:'preparing',deadline:'2027-02-01',tasks:Array(9).fill(0)};return [p.id,{...base,tasks:[...base.tasks],progress:progressOf(base.tasks)}]}));
+const dayDiff=d=>Math.ceil((new Date(d+'T00:00:00Z')-new Date('2026-10-03T00:00:00Z'))/86400000);const dateLabel=d=>{const [y,m,x]=d.split('-');return `${y}/${m}/${x}`};
+function TaskHelp({task,notify}){const msg=/推荐人|推荐信/.test(task)?'需要我帮你生成给老师的推荐信请求邮件吗？':/PS|陈述|文书/.test(task)?'去诊断我的PS，围绕这个项目检查要求和内容。':'我可以帮你把这项任务拆成具体的准备步骤。';return <button className="db-ai-task" aria-label={'AI助手：'+task} title="查看AI助手建议" onClick={()=>notify(msg)}>✦ AI助手</button>}
+export default function Dashboard(){const [view,setView]=useState('board'),[expanded,setExpanded]=useState({}),[states,setStates]=useState(seedState),[toast,setToast]=useState(''),[posts,setPosts]=useState([{id:1,tag:'求助',text:'曼大网推链接，老师收不到怎么办？'},{id:2,tag:'找搭子',text:'2027 Fall UCL 通信工程，有一起准备材料的同学吗？'},{id:3,tag:'进度',text:'今天把课程清单整理完了，终于完成一个小目标。'}]),[postText,setPostText]=useState(''),[assistantOpen,setAssistantOpen]=useState(false);
+const notify=t=>setToast(t);useEffect(()=>{if(!toast)return;const id=setTimeout(()=>setToast(''),3600);return()=>clearTimeout(id)},[toast]);useEffect(()=>{const cb=e=>e.key==='Escape'&&setAssistantOpen(false);window.addEventListener('keydown',cb);return()=>window.removeEventListener('keydown',cb)},[]);
+const flat=stages.flatMap(s=>s.tasks);const updateTask=(id,key,value)=>setStates(all=>{const st=all[id],tasks=[...st.tasks],i=flat.findIndex(x=>x[0]===key);tasks[i]=value;return {...all,[id]:{...st,tasks,progress:progressOf(tasks)}}});
+const counts=Object.fromEntries(cols.map(k=>[k,programs.filter(p=>states[p.id].status===k).length]));const nearest=programs.map(p=>({p,days:dayDiff(states[p.id].deadline)})).filter(x=>x.days>=0).sort((a,b)=>a.days-b.days)[0];
+const submitPost=e=>{e.preventDefault();if(!postText.trim())return;setPosts(x=>[{id:Date.now(),tag:'我的进度',text:postText.trim()},...x]);setPostText('');notify('动态仅在当前页面模拟显示，没有发布给其他人。')};
+const hint=(p,s)=>s.status==='referee'?'下一步：确认推荐人已收到网推链接':s.progress<50&&p.materials.includes('PS')?'AI建议：先核对 PS 要求，再整理项目素材':s.progress<50?'下一步：完成基础材料并逐项核对':s.progress<100?'下一步：完成网申材料核对与提交':'申请清单已完成，继续留意学校通知';
+function Card({program:p}){const s=states[p.id],due=dayDiff(s.deadline),risk=due<14&&s.progress<50,open=!!expanded[p.id],taskStatus=key=>s.tasks[flat.findIndex(x=>x[0]===key)]??0;return <article className={'db-card application-project '+(open?'open':'')}><button className="db-card-toggle" aria-expanded={open} onClick={()=>setExpanded(x=>({...x,[p.id]:!x[p.id]}))}><div className="db-card-head"><span className="db-school-mark">{p.mark}</span><div className="db-name"><strong>{p.school}</strong><small>{p.name} · {p.entry}</small></div><span className={'db-status '+(risk?'red':meta[s.status].color)}>{risk?'高风险':meta[s.status].label}</span></div><div className="db-progress-meta"><span>申请准备进度</span><b>{s.progress}%</b></div><div className="db-progress"><i style={{width:s.progress+'%'}}/></div><div className="db-hint"><span>✦</span><p>{hint(p,s)}</p></div><div className="db-microline">{[['网推完成','academic-reference'],['雅思出分','language-proof'],['文书定稿','personal-statement']].map(([t,k])=><div className={taskStatus(k)===2?'done':''} key={k}><i>{taskStatus(k)===2?'✓':'○'}</i><span>{t}</span></div>)}</div><div className="db-card-foot"><span className={due<14?'urgent':''}>演示DDL · {due} 天后</span><span>{open?'收起清单':'展开项目清单'} <b>{open?'−':'＋'}</b></span></div></button>{open&&<div className="db-checklist">{stages.map((g,si)=><details open={si===0} key={g.title}><summary><span>{g.title}</span><small>{g.tasks.filter(([k])=>taskStatus(k)===2).length}/{g.tasks.length}</small></summary><div className="db-stage-tasks">{g.tasks.map(([key,label])=><div className="db-task" key={key}><div className="db-task-copy"><strong>{label}</strong><small>预计耗时：2天</small></div><select aria-label={`${p.name} · ${label}状态`} value={taskStatus(key)} onChange={e=>updateTask(p.id,key,Number(e.target.value))}><option value="0">未开始</option><option value="1">进行中</option><option value="2">已完成</option></select><TaskHelp task={label} notify={notify}/></div>)}</div></details>)}</div>}</article>}
+const assistantText=nearest?`检测到你的${nearest.p.school}「${nearest.p.name}」有 ${nearest.days} 天后的演示截止日期，当前进度 ${states[nearest.p.id].progress}%。${nearest.days<14&&states[nearest.p.id].progress<50?'建议先处理未完成的核心材料。':'可以继续按清单逐项准备。'}`:'没有正在倒计时的演示日期。';
+return <div className="db-app"><div className="db-header"><div className="db-title"><span className="db-kicker">YOUR APPLICATIONS</span><h1>我的申请驾驶舱</h1><p>申请有进度，准备也可以从容一点。</p></div><div className="db-view-switch" role="group" aria-label="申请项目视图"><button className={view==='board'?'active':''} aria-pressed={view==='board'} onClick={()=>setView('board')}>▦ 列表视图</button><button className={view==='timeline'?'active':''} aria-pressed={view==='timeline'} onClick={()=>setView('timeline')}>◷ 时间轴视图</button></div></div><div className="db-summary"><div className="db-summary-count"><span><strong>{programs.length}</strong> 个目标项目</span><i/><span><strong>{counts.preparing}</strong> 个准备中</span><i/><span><strong>{programs.filter(p=>states[p.id].progress===100).length}</strong> 个清单已完成</span></div><div className="db-deadline"><span>最近演示DDL</span><strong>距离截止日期还有 <b>{nearest?.days??'—'}</b> 天</strong><small>{nearest?.p.school} · {nearest?dateLabel(states[nearest.p.id].deadline):''}（非官网实际截止日）</small></div></div><div className="db-disclaimer"><span>演示数据</span><p>项目进度均为虚构示例。倒计时固定按 2026-10-03 为参考日计算，不代表学校官网截止日期。修改状态仅在当前浏览期间生效。</p></div>{view==='board'?<div className="db-kanban">{cols.map(col=><section className="db-column" key={col}><div className="db-column-head"><h2><i className={'dot '+meta[col].color}/>{meta[col].label}</h2><span>{counts[col]}</span></div><div className="db-column-body">{programs.filter(p=>states[p.id].status===col).map(p=><Card key={p.id} program={p}/>)}{!counts[col]&&<div className="db-empty-column">{col==='submitted'?'递交完成后，项目会出现在这里。':col==='offer'?'收到录取后，我们一起记录这个好消息。':'暂无项目'}</div>}</div></section>)}</div>:<div className="db-timeline-view"><div className="db-timeline-axis">{[['现在','材料准备'],['2026年10月','首个演示节点'],['2026年11月','后续演示节点'],['2026年12月','后续演示节点']].map(([a,b])=><div key={a}><b>{a}</b><span>{b}</span></div>)}</div>{programs.map(p=>{const s=states[p.id];return <div className="db-timeline-row" key={p.id}><div><strong>{p.school}</strong><small>{p.name}</small></div><div className="db-track"><span style={{left:`${Math.max(2,Math.min(85,dayDiff(s.deadline)/75*100))}%`}}><i/><b>{s.progress}% · {dateLabel(s.deadline)}</b></span></div><button className="db-small-button" onClick={()=>{setView('board');setExpanded(x=>({...x,[p.id]:true}))}}>查看清单</button></div>})}</div>}<div className="db-bottom-grid"><section className="db-community"><div className="db-section-title"><div><span className="db-kicker">YOU’RE NOT ALONE</span><h2>申请者互助营地</h2></div><span className="db-privacy-note">匿名动态 · 本地模拟</span></div><div className="db-posts">{posts.map(p=><article key={p.id}><span>[{p.tag}]</span><p>{p.text}</p><button onClick={()=>notify('互动仅为演示，暂未发送。')}>回应</button></article>)}</div><form className="db-share" onSubmit={submitPost}><label className="sr-only" htmlFor="share-progress">分享我的申请进度或吐槽</label><input id="share-progress" value={postText} onChange={e=>setPostText(e.target.value)} maxLength={240} placeholder="分享我的申请进度 / 吐槽…"/><button disabled={!postText.trim()}>分享</button></form></section><aside className="db-peer"><span className="db-kicker">A GENTLE CHECK-IN</span><h2>也看看大家的节奏</h2><div className="db-peer-stat"><strong>75%</strong><div><b>同辈进度演示</b><small>与你背景相似的学生已完成递交</small></div></div><div className="db-peer-bar"><i/></div><p>仅用于展示模块，不代表真实用户统计。你可以按自己的节奏准备。</p></aside></div><button className="db-assistant-launch" aria-expanded={assistantOpen} aria-controls="db-assistant-panel" onClick={()=>setAssistantOpen(v=>!v)}>✦ 申请小助手 <small>演示</small></button>{assistantOpen&&<section className="db-assistant-panel" id="db-assistant-panel"><div className="db-assistant-head"><div><strong>申请小助手</strong><small>根据当前演示项目和清单</small></div><button aria-label="关闭申请小助手" onClick={()=>setAssistantOpen(false)}>×</button></div><div className="db-assistant-content"><span>主动提醒</span><p>{assistantText}</p><button onClick={()=>{if(nearest){setView('board');setExpanded(x=>({...x,[nearest.p.id]:true}));setAssistantOpen(false)}}}>查看相关项目清单</button></div><a href="#programs">前往项目库核对官方要求</a></section>}{toast&&<div className="db-toast" role="status">{toast}</div>}</div>;
+}
