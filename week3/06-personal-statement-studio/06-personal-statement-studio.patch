v className="coach-cv-row head"><span>时间</span><span>经历 / 项目</span><span>关键词与成果</span><span></span></div>{rows.map((row,i)=><div className="coach-cv-row" key={i}>{row.map((cell,j)=><input key={j} aria-label={`第${i+1}条经历，第${j+1}列`} value={cell} onChange={e=>setRows(v=>v.map((r,k)=>k===i?r.map((c,n)=>n===j?e.target.value:c):r))}/>) }<button aria-label={`删除第${i+1}条经历`} onClick={()=>setRows(v=>v.filter((_,k)=>k!==i))}>×</button></div>)}</div><div className="coach-editor-footer"><span>虚构示例 · 请替换为本人核实后的经历。</span><div><button className="coach-button secondary" onClick={save}>保存草稿</button><button className="coach-button primary" onClick={diagnose}>检查结构</button></div></div></div>}
