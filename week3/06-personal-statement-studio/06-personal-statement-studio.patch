+ function save(){try{localStorage.setItem('offergo-coach-demo',JSON.stringify({type,target,text,fields,rows}));notify('草稿已保存在此浏览器中；没有上传。')}catch{notify('当前浏览器无法保存，请保持页面打开。')}}
